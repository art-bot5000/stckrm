# ═══════════════════════════════════════════════════════════
#  STOCKROOM — Caddy reverse-proxy & static-file config
# ═══════════════════════════════════════════════════════════
# Hostname routing strategy:
#   stckrm.com           → CANONICAL apex; serves landing page (marketing)
#                          + reverse-proxies API endpoints to Deno
#   www.stckrm.com       → 301 redirects to https://stckrm.com (apex canonical)
#   app.stckrm.com       → serves the PWA (index.html)
#                          + reverse-proxies API endpoints to Deno
#   *.fly.dev / no host  → fallback for Fly edge health checks; serves PWA
#
# IMPORTANT — port binding:
# TLS termination is handled by Fly's edge. Fly forwards plain HTTP traffic
# to port 8080 inside the container. We therefore bind ALL named site
# blocks explicitly to :8080 (e.g. `stckrm.com:8080`). If we used
# `http://stckrm.com` instead, Caddy would listen on port 80 (which Fly
# never forwards to), and every request would fall through to the catch-all
# `:8080` block, breaking hostname routing entirely.

# ── Global options ──
# Disable auto-HTTPS — Fly's edge handles TLS, so Caddy serves only HTTP
# internally. Without this, Caddy would attempt to acquire its own
# certificates via ACME and add HTTP→HTTPS redirects, both of which we do
# not want.
{
    auto_https off
}

# ── Common API reverse-proxy snippet ──
# Reused on every hostname that needs to serve the API. Keep this list in
# sync with main.ts route definitions. Catches both the existing API
# routes and the new /webhook/stripe endpoint.
#
# NOTE on syntax: Caddy snippets require multi-line braces (opening brace
# must NOT be on the same line as the directive). This is stricter than
# top-level site blocks where one-liners are allowed.
(api_routes) {
    handle /ping {
        reverse_proxy localhost:8000
    }
    handle /webhook/stripe {
        reverse_proxy localhost:8000
    }
    handle /auth/* {
        reverse_proxy localhost:8000
    }
    handle /user/* {
        reverse_proxy localhost:8000
    }
    handle /device/* {
        reverse_proxy localhost:8000
    }
    handle /share/* {
        reverse_proxy localhost:8000
    }
    handle /schedule/* {
        reverse_proxy localhost:8000
    }
    handle /passkey/* {
        reverse_proxy localhost:8000
    }
    handle /admin/* {
        reverse_proxy localhost:8000
    }
    handle /household/* {
        reverse_proxy localhost:8000
    }
    handle /items/* {
        reverse_proxy localhost:8000
    }
    handle /key/* {
        reverse_proxy localhost:8000
    }
    handle /data/* {
        reverse_proxy localhost:8000
    }
    handle /recovery/* {
        reverse_proxy localhost:8000
    }
    handle /email/* {
        reverse_proxy localhost:8000
    }
    handle /invite/* {
        reverse_proxy localhost:8000
    }
    handle /crypto/* {
        reverse_proxy localhost:8000
    }
    handle /sync/* {
        reverse_proxy localhost:8000
    }
    handle /presence* {
        reverse_proxy localhost:8000
    }
    handle /reminder* {
        reverse_proxy localhost:8000
    }
    handle /status {
        reverse_proxy localhost:8000
    }
    handle /register {
        reverse_proxy localhost:8000
    }
    handle /unregister {
        reverse_proxy localhost:8000
    }
    handle /unsubscribe {
        reverse_proxy localhost:8000
    }
    handle /check-now {
        reverse_proxy localhost:8000
    }
    handle /send-now {
        reverse_proxy localhost:8000
    }
    handle /debug-schedule {
        reverse_proxy localhost:8000
    }
    handle /reset-schedule {
        reverse_proxy localhost:8000
    }
    handle /set-schedule {
        reverse_proxy localhost:8000
    }
    handle /send-reminder {
        reverse_proxy localhost:8000
    }
    handle /debug-user {
        reverse_proxy localhost:8000
    }
}

# ── Common static-file headers snippet ──
(static_assets) {
    @html path *.html
    header @html Cache-Control "no-cache, no-store, must-revalidate"

    @sw path /sw.js
    header @sw Cache-Control "no-cache, no-store, must-revalidate"

    @manifest path /manifest.json
    header @manifest Cache-Control "public, max-age=3600"

    @assets path *.js *.css
    header @assets Cache-Control "public, max-age=3600"

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=*, microphone=()"
        -Server
    }
}

# ── Common encoding snippet ──
(compression) {
    encode {
        zstd
        br
        gzip
        minimum_length 256
    }
}

# ═══════════════════════════════════════════════════════════
# Site: www.stckrm.com — 301 redirect to canonical apex
# ═══════════════════════════════════════════════════════════
# Permanent redirect so browsers and search engines treat the apex as
# canonical. Path and query are preserved via {uri}.
www.stckrm.com:8080 {
    redir https://stckrm.com{uri} permanent
}

# ═══════════════════════════════════════════════════════════
# Site: stckrm.com — canonical apex, serves landing page
# ═══════════════════════════════════════════════════════════
# Visitors hitting stckrm.com/ see landing.html. The landing page itself
# has client-side logic that auto-redirects installed PWAs and signed-in
# users to app.stckrm.com — so this site purely hosts the marketing page.
# API endpoints still proxy to Deno so the webhook (and any future
# apex-hosted API) work.
stckrm.com:8080 {
    import compression
    import api_routes

    handle {
        root * /app/public
        # Default file served at / is landing.html (not index.html which is
        # the PWA). All other static assets resolve normally.
        try_files {path} /landing.html
        file_server
        import static_assets
    }
}

# ═══════════════════════════════════════════════════════════
# Site: app.stckrm.com — the PWA itself
# ═══════════════════════════════════════════════════════════
# Serves index.html as the default. This is the URL the PWA's
# manifest.json declares as start_url, so installed apps live here.
app.stckrm.com:8080 {
    import compression
    import api_routes

    handle {
        root * /app/public
        # SPA fallback: any unmatched path resolves to index.html so client
        # routing (?action=login etc.) works even on cold loads.
        try_files {path} /index.html
        file_server
        import static_assets
    }
}

# ═══════════════════════════════════════════════════════════
# Fallback: Fly health checks, .fly.dev hostname, anything else
# ═══════════════════════════════════════════════════════════
# This catch-all matches port 8080 with no specific hostname. It catches
# Fly's internal health checks (which come in without a Host header) and
# anyone hitting stckrm.fly.dev directly. Serves the PWA so the .fly.dev
# URL still works for debugging.
:8080 {
    import compression
    import api_routes

    handle {
        root * /app/public
        try_files {path} /index.html
        file_server
        import static_assets
    }
}
