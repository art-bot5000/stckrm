# stckrm.com infrastructure
# ─────────────────────────
# Three hostnames served from one Fly machine. Caddy listens on :8080
# because Fly's edge proxy terminates TLS and forwards plaintext on that
# port — we don't issue our own certs.
#
#   stckrm.com         → 301 redirect to www.stckrm.com (apex → www)
#   www.stckrm.com     → marketing landing page (landing.html)
#   app.stckrm.com     → PWA + backend API
#
# A bare *.fly.dev hostname (or anything else not matched) falls through
# to a fallback block that preserves the pre-domain behaviour.
#
# Style note: when handle blocks are nested inside other handle blocks,
# Caddy requires the body to start on a NEW line (not inline with the
# matcher). All API route handlers below follow that pattern.

:8080 {
    encode {
        zstd
        br
        gzip
        minimum_length 256
    }

    # ── 1. Apex redirect ────────────────────────────────────────────────
    @apex host stckrm.com
    handle @apex {
        redir https://www.stckrm.com{uri} permanent
    }

    # ── 2. Marketing landing (www) ──────────────────────────────────────
    @www host www.stckrm.com
    handle @www {
        root * /app/public
        rewrite / /landing.html

        file_server

        @html path *.html
        header @html Cache-Control "no-cache, no-store, must-revalidate"

        header {
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Referrer-Policy "strict-origin-when-cross-origin"
            Permissions-Policy "camera=(), microphone=()"
            -Server
        }
    }

    # ── 3. App hostname (PWA + backend API) ─────────────────────────────
    @app host app.stckrm.com
    handle @app {
        # Backend API — proxied to main.ts on :8000.
        # Body on next line because nested handle blocks require it.
        handle /ping {
            reverse_proxy localhost:8000
        }
        handle /auth/* {
            reverse_proxy localhost:8000
        }
        handle /user/* {
            reverse_proxy localhost:8000
        }
        handle /device/* {
            reverse_proxy localhost:8000
        }
        handle /share/* {
            reverse_proxy localhost:8000
        }
        handle /schedule/* {
            reverse_proxy localhost:8000
        }
        handle /passkey/* {
            reverse_proxy localhost:8000
        }
        handle /admin/* {
            reverse_proxy localhost:8000
        }
        handle /household/* {
            reverse_proxy localhost:8000
        }
        handle /items/* {
            reverse_proxy localhost:8000
        }
        handle /key/* {
            reverse_proxy localhost:8000
        }
        handle /data/* {
            reverse_proxy localhost:8000
        }
        handle /recovery/* {
            reverse_proxy localhost:8000
        }
        handle /email/* {
            reverse_proxy localhost:8000
        }
        handle /invite/* {
            reverse_proxy localhost:8000
        }
        handle /crypto/* {
            reverse_proxy localhost:8000
        }
        handle /sync/* {
            reverse_proxy localhost:8000
        }
        handle /presence* {
            reverse_proxy localhost:8000
        }
        handle /reminder* {
            reverse_proxy localhost:8000
        }
        handle /note/* {
            reverse_proxy localhost:8000
        }
        handle /mfa/* {
            reverse_proxy localhost:8000
        }
        handle /status {
            reverse_proxy localhost:8000
        }
        handle /register {
            reverse_proxy localhost:8000
        }
        handle /unregister {
            reverse_proxy localhost:8000
        }
        handle /unsubscribe {
            reverse_proxy localhost:8000
        }
        handle /check-now {
            reverse_proxy localhost:8000
        }
        handle /send-now {
            reverse_proxy localhost:8000
        }
        handle /debug-schedule {
            reverse_proxy localhost:8000
        }
        handle /reset-schedule {
            reverse_proxy localhost:8000
        }
        handle /set-schedule {
            reverse_proxy localhost:8000
        }
        handle /send-reminder {
            reverse_proxy localhost:8000
        }

        # Static frontend — the PWA at root.
        handle {
            root * /app/public

            # /app and /app/ → / (preserves query string for ?action=demo)
            @legacyApp path /app /app/
            redir @legacyApp / permanent

            file_server

            @html path *.html
            header @html Cache-Control "no-cache, no-store, must-revalidate"

            @sw path /sw.js
            header @sw Cache-Control "no-cache, no-store, must-revalidate"

            @manifest path /manifest.json
            header @manifest Cache-Control "public, max-age=3600"

            @assets path *.js *.css
            header @assets Cache-Control "public, max-age=31536000, immutable"

            header {
                X-Content-Type-Options "nosniff"
                X-Frame-Options "DENY"
                Referrer-Policy "strict-origin-when-cross-origin"
                Permissions-Policy "camera=*, microphone=()"
                -Server
            }
        }
    }

    # ── 4. Fallback — fly.dev or any other host ─────────────────────────
    # Same behaviour as the original single-host Caddyfile so health
    # checks and direct fly.dev access keep working.
    handle {
        handle /ping {
            reverse_proxy localhost:8000
        }
        handle /auth/* {
            reverse_proxy localhost:8000
        }
        handle /user/* {
            reverse_proxy localhost:8000
        }
        handle /device/* {
            reverse_proxy localhost:8000
        }
        handle /share/* {
            reverse_proxy localhost:8000
        }
        handle /schedule/* {
            reverse_proxy localhost:8000
        }
        handle /passkey/* {
            reverse_proxy localhost:8000
        }
        handle /admin/* {
            reverse_proxy localhost:8000
        }
        handle /household/* {
            reverse_proxy localhost:8000
        }
        handle /items/* {
            reverse_proxy localhost:8000
        }
        handle /key/* {
            reverse_proxy localhost:8000
        }
        handle /data/* {
            reverse_proxy localhost:8000
        }
        handle /recovery/* {
            reverse_proxy localhost:8000
        }
        handle /email/* {
            reverse_proxy localhost:8000
        }
        handle /invite/* {
            reverse_proxy localhost:8000
        }
        handle /crypto/* {
            reverse_proxy localhost:8000
        }
        handle /sync/* {
            reverse_proxy localhost:8000
        }
        handle /presence* {
            reverse_proxy localhost:8000
        }
        handle /reminder* {
            reverse_proxy localhost:8000
        }
        handle /note/* {
            reverse_proxy localhost:8000
        }
        handle /mfa/* {
            reverse_proxy localhost:8000
        }
        handle /status {
            reverse_proxy localhost:8000
        }
        handle /register {
            reverse_proxy localhost:8000
        }
        handle /unregister {
            reverse_proxy localhost:8000
        }
        handle /unsubscribe {
            reverse_proxy localhost:8000
        }
        handle /check-now {
            reverse_proxy localhost:8000
        }
        handle /send-now {
            reverse_proxy localhost:8000
        }
        handle /debug-schedule {
            reverse_proxy localhost:8000
        }
        handle /reset-schedule {
            reverse_proxy localhost:8000
        }
        handle /set-schedule {
            reverse_proxy localhost:8000
        }
        handle /send-reminder {
            reverse_proxy localhost:8000
        }

        handle {
            root * /app/public
            rewrite / /landing.html
            rewrite /app /index.html

            file_server

            @html path *.html
            header @html Cache-Control "no-cache, no-store, must-revalidate"

            @sw path /sw.js
            header @sw Cache-Control "no-cache, no-store, must-revalidate"

            @manifest path /manifest.json
            header @manifest Cache-Control "public, max-age=3600"

            @assets path *.js *.css
            header @assets Cache-Control "public, max-age=31536000, immutable"

            header {
                X-Content-Type-Options "nosniff"
                X-Frame-Options "DENY"
                Referrer-Policy "strict-origin-when-cross-origin"
                Permissions-Policy "camera=*, microphone=()"
                -Server
            }
        }
    }
}
